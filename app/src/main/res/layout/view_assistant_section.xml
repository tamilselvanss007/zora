<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Sora.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/section_assistant"
        tools:ignore="HardcodedText" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Sora.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/which_ai"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/aiModeChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/aiModeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/voice_command_language"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/speechLangChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/speechLangHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/confirmSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/confirm_sensitive"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/shareMemorySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/share_memory_cloud"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autoStartSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/autostart_local_model"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/localServerUrlLayout"
                style="@style/Sora.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/llm_server_url"
                app:helperText="@string/llm_server_url_hint"
                app:helperTextTextColor="@color/text_dim"
                tools:ignore="HardcodedText">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/localServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetLocalUrlButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/llm_server_url_reset"
                    android:textColor="@color/accent"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveLocalUrlButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/save"
                    app:cornerRadius="10dp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/localStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/rememberTasksSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remember_tasks"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/embeddedSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/use_embedded_model"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mobileDownloadSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/allow_mobile_data_download"
                android:textColor="@color/text"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/runtimeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runtimeButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/download_embedded_model"
                app:cornerRadius="12dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permissionsButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/allow_contacts"
                app:cornerRadius="12dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/memoriesButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/memories"
                app:cornerRadius="12dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
